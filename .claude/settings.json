{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git -C *)",
      "Bash(./charly/bin/charly task *)",
      "Bash(charly task *)",
      "Bash(./charly/scripts/bootstrap-charly.sh)",
      "Bash(bash scripts/*)",
      "Bash(gh api --method POST repos/opencharly:*)"
    ]
  },
  "enabledMcpjsonServers": [
    "deepwiki"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-gate.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-gate.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "charly-agent@charly-plugins": true,
    "charly-ai-toolkit@charly-plugins": true,
    "charly-authoring@charly-plugins": true,
    "charly-automation@charly-plugins": true,
    "charly-bpf@charly-plugins": true,
    "charly-build@charly-plugins": true,
    "charly-cache@charly-plugins": true,
    "charly-candy-cli@charly-plugins": true,
    "charly-cardwire@charly-plugins": true,
    "charly-check@charly-plugins": true,
    "charly-coder@charly-plugins": true,
    "charly-comfyui@charly-plugins": true,
    "charly-core@charly-plugins": true,
    "charly-crabbox@charly-plugins": true,
    "charly-distros@charly-plugins": true,
    "charly-feature@charly-plugins": true,
    "charly-filebrowser@charly-plugins": true,
    "charly-fireactions@charly-plugins": true,
    "charly-firecracker@charly-plugins": true,
    "charly-hermes@charly-plugins": true,
    "charly-image@charly-plugins": true,
    "charly-immich@charly-plugins": true,
    "charly-infrastructure@charly-plugins": true,
    "charly-internals@charly-plugins": true,
    "charly-jupyter@charly-plugins": true,
    "charly-kubernetes@charly-plugins": true,
    "charly-kubevirt@charly-plugins": true,
    "charly-languages@charly-plugins": true,
    "charly-local@charly-plugins": true,
    "charly-ollama@charly-plugins": true,
    "charly-openclaw@charly-plugins": true,
    "charly-openwebui@charly-plugins": true,
    "charly-pipeline@charly-plugins": true,
    "charly-pod-verbs@charly-plugins": true,
    "charly-pod@charly-plugins": true,
    "charly-punktfunk@charly-plugins": true,
    "charly-qdrant@charly-plugins": true,
    "charly-qwen3-tts@charly-plugins": true,
    "charly-review@charly-plugins": true,
    "charly-strata@charly-plugins": true,
    "charly-tools@charly-plugins": true,
    "charly-vm@charly-plugins": true,
    "claude-md-management@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "charly-plugins": {
      "source": {
        "source": "github",
        "repo": "opencharly/marketplace"
      }
    }
  }
}

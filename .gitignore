# secrets — never commit keys
*.pem
*.key
*.p12

# local env
.env

# Pi project-local package installs (generated on startup from .pi/settings.json)
.pi/npm/

# Pi marketplace cache (cloned skill/marketplace repos, generated on startup)
.pi/git/

# pi-claude-marketplace state (marketplace clones + installed resources, regenerated by /claude:plugin import)
.pi/pi-claude-marketplace/
.pi/agents/
.pi/claude-plugins.local.json

# pi-fabric runtime data (mcp cache, mesh state)
.pi/fabric/

# Claude Code runtime lock (session-local, never committed)
.claude/scheduled_tasks.lock

# plans — working docs, never committed; directory kept via .gitkeep
plan/*
!plan/.gitkeep

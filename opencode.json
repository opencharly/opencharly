{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/instructions.md", "SOUL.md"],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 384000,
    "preserve_recent_tokens": 500000
  },
  "skills": {
    "paths": ["marketplace"]
  },
  "lsp": true,
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    }
  },
  "provider": {
    "ollama-cloud": {
      "models": {
        "deepseek-v4.1-flash": {
          "limit": {
            "context": 1048576,
            "input": 1048576,
            "output": 384000
          },
          "options": {
            "max_tokens": 262144,
            "reasoningEffort": "high",
            "temperature": 1.0,
            "top_p": 0.95,
            "frequency_penalty": 0.5,
            "presence_penalty": 1.0
          }
        }
      }
    }
  },
  "references": {
    "marketplace": {
      "path": "marketplace",
      "description": "The OpenCharly skill corpus. Read a skill's procedure at marketplace/<family>/skills/<skill>/SKILL.md (the harness-neutral fallback when the skill tool does not expose it)."
    }
  },
  "permissions": [
    { "action": "shell", "resource": "gh pr merge*", "effect": "deny" },
    { "action": "shell", "resource": "git push *--force*", "effect": "deny" },
    { "action": "shell", "resource": "git commit *--no-verify*", "effect": "deny" }
  ]
}

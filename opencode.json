{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/instructions.md"],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 384000,
    "preserve_recent_tokens": 500000
  },
  "skills": {
    "paths": ["marketplace"]
  },
  "lsp": true,
  "provider": {
    "ollama-cloud": {
      "models": {
        "deepseek-v4.1-flash": {
          "limit": {
            "context": 1048576,
            "input": 1048576,
            "output": 384000
          },
          "options": {
            "max_tokens": 262144,
            "reasoningEffort": "high",
            "temperature": 1.0,
            "top_p": 0.95,
            "frequency_penalty": 0.5,
            "presence_penalty": 1.0
          }
        }
      }
    }
  },
  "references": {
    "marketplace": {
      "path": "marketplace",
      "description": "The OpenCharly skill corpus. Read a skill's procedure at marketplace/<family>/skills/<skill>/SKILL.md (the harness-neutral fallback when the skill tool does not expose it)."
    }
  },
  "permission": {
    "skill": {
      "git-workflow": "allow",
      "strict-policy": "allow",
      "root-cause-analyzer": "allow",
      "agents": "allow",
      "check": "allow",
      "agent": "allow",
      "alias": "allow",
      "charly-config": "allow",
      "charly-doctor": "allow",
      "secrets": "allow",
      "image": "allow",
      "layer": "allow",
      "docs": "allow",
      "marketplace": "allow",
      "skills": "allow",
      "cutover-policy": "allow",
      "disposable": "allow",
      "plugin": "allow",
      "capabilities": "allow"
    },
    "bash": {
      "./charly/bin/charly task *": "allow",
      "charly task *": "allow",
      "bash scripts/*": "allow",
      "git -C *": "allow",
      "gh pr merge *": "allow",
      "gh api --method POST repos/opencharly/*": "allow"
    }
  }
}

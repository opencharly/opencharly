#!/usr/bin/env bash
# pre-push — the umbrella's PRE-PUSH gate (the clone-level git hook).
#
# Installed per clone with `charly task hooks` (git config core.hooksPath hooks).
# This IS repo configuration, not the `git -c core.hooksPath=… commit` bypass that
# .claude/hooks/gitcmd.py blocks (AGENTS.md R6). It is also DISTINCT from
# `.claude/hooks/pre-push-gate.sh`: that one is a harness PreToolUse gate over the
# COMMAND TEXT (force-push, a direct push to main, untokenizable commands); this hook
# runs on the actual push, from git.
#
# It runs TWO assertions. The first is the org's own body linter
# (`marketplace/scripts/pr_body_lint.py`), which judges the body's FORM. The second is
# the umbrella's own reconciliation (`scripts/check-pr-body-diff.mjs`), which asks a
# question the linter cannot: does the body DESCRIBE the diff it is published with?
# The body IS the changelog and the validator reads it LIVE, so a mechanically-detectable
# body defect — a missing required section, a trailer that is not the last line, a bare
# `N/A`, an ellipsized fence, a pasted head SHA that is not HEAD — costs a whole review
# round when the validator finds it, and a second when this does. The same is true of a
# file table that lists a file the diff does not change, or one that omits a file it
# does, or a gate evidence block pasted from a tree that is not the head being pushed:
# the validator caught all three on this repo's own PR (2026-10-23), a whole round
# after the push that could have been stopped here. Hooks guard DETERMINISTIC
# MECHANICS only, which is exactly this class: it checks the body's FORM and its
# FIDELITY TO THE DIFF, and judges nothing about the change, the tier, or the evidence.
#
# THE TREE THE BODY IS RECONCILED AGAINST IS THE TREE THE PUSH PUBLISHES. git writes the
# refs it publishes to this hook's stdin, and the LOCAL SHA on such a line is the commit
# the push publishes — which is NOT the checkout's HEAD whenever the push publishes a
# branch other than the checked-out one: `git push origin other` publishes `other`'s
# commit while the checkout still sits on `main`. Reconciling against `HEAD` therefore
# judged the body against a tree the push does not publish — a false PASS for a body
# that described the pushed branch, and a false BLOCK for a body that described the
# checkout (opencharly/opencharly#744). The reconciliation is run against the PUBLISHED
# commit, named with `--head`; the checked-out tree is the fallback for a push that
# publishes no single branch (a tag, a deletion, several branches at once, or a
# hand-run hook), and that fallback is the tree it always read.
#
# THE BODY PATH defaults to the GIT DIR — `git rev-parse --absolute-git-dir`, which is
# per-WORKTREE (`…/.git/worktrees/<name>`), so two session worktrees can never fight
# over one body, and absolute, so it survives a change of cwd. It never dirties the
# tracked tree and it survives across a push. Override with `PR_BODY_FILE=<path>`.
#
# THE LIVE BODY IS A SECOND SURFACE, AND IT IS THE ONE THE VALIDATOR READS. The body
# this hook validates lives in a FILE; the validator reads the body's LIVE copy, on the
# PR, from GitHub. Nothing reconciled the two, so a body FILE that was correct
# while the PR's body was stale passed this hook perfectly and cost a whole review
# round — opencharly/opencharly#742, 2026-10-27: the validator read a body naming a
# head and a file table this hook had already rejected for the tree being pushed,
# because the file had been fixed AFTER the push and the PR's copy had not. The check
# below IS that reconciliation: the body the push publishes MUST be the body GitHub
# holds, or the body is not the changelog the reviewer reads.
#
# SKIP COUNTS: hook=8 live-body=6   (machine-checked by scripts/check-pr-body-gate.mjs)
#
# EVERY SKIP IS VISIBLE AND NEVER FAIL-CLOSED, the shape pre-commit-gate.sh already uses
# for a missing golangci-lint, and every one of them carries a marker the gate COUNTS —
# so the counts above cannot drift away from the code they describe.
#
# THE HOOK'S OWN 8:
#   * NO GIT TREE — the hook does not run inside a git working tree at all.
#   * NO GIT DIR — the working tree's git dir could not be resolved.
#   * NO BODY at the path — the body is written by the author as part of the landing
#     discipline, so its absence at push time is the DISCIPLINE failing, not a defect
#     in the diff. A hook that blocked there would be inventing a rule, so it says how
#     to create the file and gets out of the way.
#   * NO RECONCILER — the reconciliation is a script in THIS repo, so its absence is
#     this checkout being incomplete rather than the diff being wrong; it is named and
#     the push continues.
#   * NO node — the same, for the interpreter the reconciliation runs under.
#   * NO LINTER — `marketplace/` is a submodule a session worktree may not have
#     materialized, and blocking a push for an unmaterialized submodule would make
#     every fresh worktree unlandable. It names the one command that fixes it.
#   * NO python3 — the same, for the interpreter the linter runs under.
#   * A LINTER THAT CANNOT RUN — the linter is here but its sibling module from the
#     marketplace submodule is not, so it dies with a traceback that also exits 1.
#
# THE LIVE-BODY CHECK'S 6: no `gh` (not installed); no single branch to resolve a PR
# from; a remote that is not GitHub; `gh` failing to list the open PRs; no open PR for
# the PUBLISHED branch (the first push OPENS the PR — its body is set at creation); and
# `gh` failing to read that PR's body. A push that cannot be checked is still a push;
# what it must never be is a SILENT one.

set -uo pipefail

# git hands a pre-push hook the refs it is PUBLISHING on STDIN, one line per ref:
#
#   <local ref> <local sha> <remote ref> <remote sha>
#
# Read them ONCE, here, BEFORE any child process runs: a child that inherits this pipe
# could consume the lines. A terminal on stdin means the hook was run BY HAND, and a
# hand-run hook must not block waiting for a line that will never come.
PUSH_REFS=""
if [ ! -t 0 ]; then
  PUSH_REFS="$(cat 2>/dev/null || true)"
fi

# ── the PUBLISHED refs, resolved ONCE ───────────────────────────────────────────────
# git publishes a ref by writing FOUR fields to this hook's stdin:
#
#   <local ref> <local sha> <remote ref> <remote sha>
#
# The LOCAL SHA is the commit the push PUBLISHES. The checkout's HEAD is a different
# commit whenever the push publishes a branch other than the checked-out one, so the
# two facts this hook needs are resolved HERE, once, and both consumers read them: the
# reconciliation (the head to read the tree from) and the LIVE-body check (the branch
# whose PR holds the body). One parse, two consumers (R2).
#
# When the push publishes no single branch — a tag, a deletion, several branches at
# once, or a hand-run hook with an empty stdin — there is no published commit, and the
# reconciliation falls back to `HEAD`: the tree it always read. The fallback is not a
# skip; the check still runs.
PUBLISHED_BRANCH=""
PUBLISHED_HEAD=""
PUBLISHED_WHY=""

resolve_published_refs() {
  local published="" published_head="" refs_seen=0 branch_refs=0
  local local_ref="" local_sha="" remote_ref="" remote_sha=""
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue
    refs_seen=$((refs_seen + 1))
    [ "$local_ref" = "(delete)" ] && continue
    case "$remote_ref" in
      refs/heads/*)
        branch_refs=$((branch_refs + 1))
        published="${remote_ref#refs/heads/}"
        published_head="$local_sha"
        ;;
    esac
  done <<< "$PUSH_REFS"

  PUBLISHED_BRANCH=""
  PUBLISHED_HEAD=""
  PUBLISHED_WHY=""

  local branch="" branch_why=""
  if [ "$branch_refs" -eq 1 ]; then
    branch="$published"
    PUBLISHED_HEAD="$published_head"
  elif [ "$branch_refs" -gt 1 ]; then
    branch_why="the push publishes $branch_refs branches at once"
  elif [ "$refs_seen" -eq 0 ]; then
    # Nothing was published: a hand-run invocation, or a push with nothing to do.
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    [ "$branch" = "HEAD" ] && branch=""
    [ -z "$branch" ] && branch_why="a detached HEAD and no published ref"
  else
    branch_why="the push publishes no branch (a tag, or a deletion)"
  fi
  PUBLISHED_BRANCH="$branch"
  PUBLISHED_WHY="$branch_why"
}

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT=""
if [ -z "$ROOT" ]; then
  echo "pre-push: [pre-push-skip] not inside a git working tree — body lint SKIPPED." >&2
  exit 0
fi

# git exports these to hooks, so they name THIS repo's git dir and corrupt any
# nested `git -C <submodule>` call. Resolve the root first (which needs them), then
# scrub them once at the boundary, exactly as hooks/pre-commit does.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
cd "$ROOT" || exit 0

GITDIR="$(git rev-parse --absolute-git-dir 2>/dev/null)" || GITDIR=""
if [ -z "$GITDIR" ]; then
  echo "pre-push: [pre-push-skip] could not resolve the git dir — body lint SKIPPED." >&2
  exit 0
fi
BODY="${PR_BODY_FILE:-$GITDIR/PR_BODY.md}"
LINT="$ROOT/marketplace/scripts/pr_body_lint.py"

if [ ! -e "$BODY" ]; then
  echo "pre-push: [pre-push-skip] no PR body at $BODY — body lint SKIPPED (nothing to check)."
  echo "pre-push: the body IS the changelog; write the whole thing for the head you are about to"
  echo "pre-push: publish and push again. To lint a body that lives elsewhere: PR_BODY_FILE=<path>."
  exit 0
fi

# The PUBLISHED refs, resolved once, for BOTH consumers below: the reconciliation reads
# the head the push publishes, the LIVE-body check reads the branch whose PR holds the
# body. It runs even when the reconciliation is skipped, so the LIVE-body check never
# loses the branch it resolves.
resolve_published_refs
RECONCILE_HEAD="${PUBLISHED_HEAD:-HEAD}"

# The umbrella's OWN reconciliation, and it runs whether or not the org's linter is
# here: the diff it reconciles against is this tree's, and it needs nothing from the
# marketplace submodule. Its skips are visible and never fail-closed, like the linter's.
RECONCILE="$ROOT/scripts/check-pr-body-diff.mjs"
if [ ! -f "$RECONCILE" ]; then
  echo "pre-push: [pre-push-skip] $RECONCILE is absent — body/diff reconciliation SKIPPED." >&2
elif ! command -v node >/dev/null 2>&1; then
  echo "pre-push: [pre-push-skip] node not found — body/diff reconciliation SKIPPED." >&2
else
  # The head the push PUBLISHES, or the checked-out tree when the push publishes no
  # single branch — the reconciler's own default, named here so the head is EXPLICIT
  # in the command that reads the tree.
  echo "pre-push: reconciling the PR body against the diff at $RECONCILE_HEAD ..."
  if node "$RECONCILE" --body "$BODY" --repo "$ROOT" --head "$RECONCILE_HEAD"; then
    echo "pre-push: OK (the body describes the diff it ships with)"
  else
    echo "pre-push: BLOCKED — the PR body does not describe the diff it is published with." >&2
    echo "pre-push: the body IS the changelog and the validator reads it live; fix EVERY finding" >&2
    echo "pre-push: and push again. Nothing about the diff's quality is judged here." >&2
    exit 1
  fi
fi

# ── the LIVE body: the copy the validator actually reads ───────────────────────────
# The body is validated as a FILE; the validator reads the PR's LIVE copy. This
# function is the reconciliation between the two, and it is the control whose absence
# let opencharly/opencharly#742 (2026-10-27) publish a body the reviewer never saw.
# It returns 0 when the two agree or when the comparison cannot be made (a VISIBLE
# skip, never a silent one), and 1 when they DISAGREE — which blocks the push.
#
# GIT'S CONTRACT, measured (git 2.56, seven push shapes): a pre-push hook is given
# TWO arguments — $1 the remote NAME, $2 that remote's URL or path — and the refs it
# publishes on STDIN. There is NO $3. The PUBLISHED branch is the REMOTE ref of a
# stdin line whose remote ref is a `refs/heads/*`: it is the branch on the platform,
# whatever the LOCAL ref was called (`HEAD:refs/heads/x` publishes `x`). A push with
# nothing to do still runs the hook, with an EMPTY stdin, and so does a hand-run
# invocation — those are the ONLY two cases where HEAD's branch is the right answer.
live_body_check() {
  if ! command -v gh >/dev/null 2>&1; then
    echo "pre-push: [live-body-skip] gh is not installed — the LIVE-body check SKIPPED (the PR's body is not compared with $BODY)."
    return 0
  fi

  # The PUBLISHED branch, resolved ONCE above from the refs git wrote to stdin — the
  # same resolution the reconciliation read its head from, so the two can never name
  # different pushes.
  local branch="$PUBLISHED_BRANCH" branch_why="$PUBLISHED_WHY"
  if [ -z "$branch" ]; then
    echo "pre-push: [live-body-skip] no single branch to resolve a PR from ($branch_why) — the LIVE-body check SKIPPED."
    return 0
  fi

  # The pushed REMOTE, from git's own $1/$2. A URL push passes the URL as BOTH; a named
  # remote passes that remote's URL as $2. So the first of $2, $1 and the configured
  # remote's URL that names a GitHub repository is the one whose PR holds the body.
  local remote_name="${1:-origin}" remote_url="" candidate=""
  for candidate in "${2:-}" "${1:-}" "$(git config --get "remote.${1:-origin}.url" 2>/dev/null || true)"; do
    case "$candidate" in
      *github.com*) remote_url="$candidate"; break ;;
    esac
  done
  if [ -z "$remote_url" ]; then
    echo "pre-push: [live-body-skip] remote '$remote_name' is not a GitHub remote — the LIVE-body check SKIPPED."
    return 0
  fi

  local path slug
  path="${remote_url#*github.com}"
  path="${path#:}"
  path="${path#/}"
  path="${path%.git}"
  slug="${path%%/*}/${path##*/}"

  local err="$GITDIR/pre-push-gh.err" pr="" ghrc=0 live="" lrc=0 local_body=""
  if ! : > "$err" 2>/dev/null; then err="/dev/null"; fi

  pr="$(gh pr list --repo "$slug" --head "$branch" --state open --json number --jq '.[0].number // empty' 2>"$err")" || ghrc=$?
  if [ "$ghrc" -ne 0 ]; then
    echo "pre-push: [live-body-skip] gh could not list the open PRs of $slug (gh exit $ghrc) — the LIVE-body check SKIPPED:" >&2
    sed -n '1p' "$err" >&2 2>/dev/null || true
    rm -f "$err" 2>/dev/null || true
    return 0
  fi
  if [ -z "$pr" ]; then
    echo "pre-push: [live-body-skip] no open PR for $slug head '$branch' — the LIVE-body check SKIPPED (the first push OPENS the PR; its body is set at creation)."
    rm -f "$err" 2>/dev/null || true
    return 0
  fi

  live="$(gh pr view "$pr" --repo "$slug" --json body --jq '.body' 2>"$err")" || lrc=$?
  rm -f "$err" 2>/dev/null || true
  if [ "$lrc" -ne 0 ]; then
    echo "pre-push: [live-body-skip] gh could not read the body of $slug#$pr (gh exit $lrc) — the LIVE-body check SKIPPED." >&2
    return 0
  fi

  # Command substitution strips the trailing newlines from BOTH sides, so the comparison
  # is about the body's TEXT and not about how the platform happens to terminate it.
  local_body="$(cat "$BODY" 2>/dev/null || true)"
  if [ "$local_body" = "$live" ]; then
    echo "pre-push: the LIVE body on $slug#$pr MATCHES $BODY — the body the validator reads is the one this push validated."
    return 0
  fi

  echo "pre-push: BLOCKED — the LIVE body on $slug#$pr does NOT match $BODY." >&2
  echo "pre-push: the validator reads the body LIVE, so the body the reviewer reads is the PR's — not this file." >&2
  echo "pre-push: publish the body, then push again:" >&2
  echo "pre-push:   gh pr edit $pr --repo $slug --body-file $BODY" >&2
  echo "pre-push: (this file is $(printf '%s' "$local_body" | wc -c) bytes; the PR holds $(printf '%s' "$live" | wc -c))" >&2
  return 1
}

if ! live_body_check "$@"; then
  exit 1
fi

if [ ! -f "$LINT" ]; then
  echo "pre-push: [pre-push-skip] $LINT is absent (the marketplace submodule is not materialized here) — body lint SKIPPED."
  echo "pre-push: materialize it with: bash scripts/init-submodules.sh  (the working set includes the marketplace)"
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-push: [pre-push-skip] python3 not found — body lint SKIPPED."
  exit 0
fi

# PRE-FLIGHT the linter, because a tool that cannot run is a VISIBLE SKIP, not a red.
# `pr_body_lint.py` imports a sibling module (`squash_body.py`), so a partial
# materialization — or any other breakage — makes it die with a Python traceback AND
# exit 1, which is INDISTINGUISHABLE from "findings" by exit code alone. Running
# `--help` exercises that import, so a non-zero here means the TOOL is broken and a
# non-zero from the real invocation below means the BODY has findings. Without this,
# one broken submodule blocks every legitimate push in the clone.
if ! python3 "$LINT" --help >/dev/null 2>&1; then
  echo "pre-push: [pre-push-skip] the body linter cannot run here (it needs its sibling module from the marketplace submodule) — body lint SKIPPED." >&2
  echo "pre-push: materialize it with: bash scripts/init-submodules.sh  (the working set includes the marketplace)" >&2
  exit 0
fi

echo "pre-push: linting the PR body at $BODY ..."
# The linter gets the SAME head the reconciliation read: it judges the body's pasted
# head claim against the commit being pushed, and its own default is the repository's
# HEAD — the checkout, which is not the tree a push of another branch publishes.
if python3 "$LINT" "$BODY" --repo "$ROOT" --head "$RECONCILE_HEAD"; then
  echo "pre-push: OK"
  exit 0
fi

echo "pre-push: BLOCKED — the PR body above has findings." >&2
echo "pre-push: the body is the changelog and the validator reads it live; fix EVERY finding" >&2
echo "pre-push: and push again. Nothing about the diff is judged here." >&2
exit 1

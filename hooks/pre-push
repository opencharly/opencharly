#!/usr/bin/env bash
# pre-push — the umbrella's PRE-PUSH gate (the clone-level git hook).
#
# Installed per clone with `charly task hooks` (git config core.hooksPath hooks).
# This IS repo configuration, not the `git -c core.hooksPath=… commit` bypass that
# .claude/hooks/gitcmd.py blocks (AGENTS.md R6). It is also DISTINCT from
# `.claude/hooks/pre-push-gate.sh`: that one is a harness PreToolUse gate over the
# COMMAND TEXT (force-push, a direct push to main, untokenizable commands); this hook
# runs on the actual push, from git.
#
# It runs TWO assertions. The first is the org's own body linter
# (`marketplace/scripts/pr_body_lint.py`), which judges the body's FORM. The second is
# the umbrella's own reconciliation (`scripts/check-pr-body-diff.mjs`), which asks a
# question the linter cannot: does the body DESCRIBE the diff it is published with?
# The body IS the changelog and the validator reads it LIVE, so a mechanically-detectable
# body defect — a missing required section, a trailer that is not the last line, a bare
# `N/A`, an ellipsized fence, a pasted head SHA that is not HEAD — costs a whole review
# round when the validator finds it, and a second when this does. The same is true of a
# file table that lists a file the diff does not change, or one that omits a file it
# does, or a gate evidence block pasted from a tree that is not the head being pushed:
# the validator caught all three on this repo's own PR (2026-10-23), a whole round
# after the push that could have been stopped here. Hooks guard DETERMINISTIC
# MECHANICS only, which is exactly this class: it checks the body's FORM and its
# FIDELITY TO THE DIFF, and judges nothing about the change, the tier, or the evidence.
#
# THE BODY PATH defaults to the GIT DIR — `git rev-parse --absolute-git-dir`, which is
# per-WORKTREE (`…/.git/worktrees/<name>`), so two session worktrees can never fight
# over one body, and absolute, so it survives a change of cwd. It never dirties the
# tracked tree and it survives across a push. Override with `PR_BODY_FILE=<path>`.
#
# THE LIVE BODY IS A SECOND SURFACE, AND IT IS THE ONE THE VALIDATOR READS. The body
# this hook validates lives in a FILE; the validator reads the body's LIVE copy, on
# the PR, from GitHub. Nothing reconciled the two, so a body FILE that was correct
# while the PR's body was stale passed this hook perfectly and cost a whole review
# round — opencharly/opencharly#742, 2026-10-27: the validator read a body naming a
# head and a file table this hook had already rejected for the tree being pushed,
# because the file had been fixed AFTER the push and the PR's copy had not. The check
# below IS that reconciliation: the body the push publishes MUST be the body GitHub
# holds, or the body is not the changelog the reviewer reads.
#
# THE LIVE-BODY CHECK SKIPS VISIBLY, never fail-closed, in the same shape as the skips
# below: no `gh` (not installed), a remote that is not GitHub, no open PR for this
# branch (the first push OPENS the PR — its body is set at creation), or `gh` itself
# failing. A push that cannot be checked is still a push; what it must never be is a
# SILENT one.
#
# SKIPS ARE VISIBLE AND NEVER FAIL-CLOSED, the shape pre-commit-gate.sh already uses
# for a missing golangci-lint. Three of them:
#   * NO BODY at the path — the body is written by the author as part of the landing
#     discipline, so its absence at push time is the DISCIPLINE failing, not a defect
#     in the diff. A hook that blocked there would be inventing a rule, so it says how
#     to create the file and gets out of the way.
#   * NO LINTER — `marketplace/` is a submodule a session worktree may not have
#     materialized, and blocking a push for an unmaterialized submodule would make
#     every fresh worktree unlandable. It names the one command that fixes it.
#   * NO RECONCILER (or no `node`) — the reconciliation is a script in THIS repo, so
#     its absence is this checkout being incomplete rather than the diff being wrong;
#     it is named and the push continues.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT=""
if [ -z "$ROOT" ]; then
  echo "pre-push: not inside a git working tree — body lint SKIPPED." >&2
  exit 0
fi

# git exports these to hooks, so they name THIS repo's git dir and corrupt any
# nested `git -C <submodule>` call. Resolve the root first (which needs them), then
# scrub them once at the boundary, exactly as hooks/pre-commit does.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
cd "$ROOT" || exit 0

GITDIR="$(git rev-parse --absolute-git-dir 2>/dev/null)" || GITDIR=""
if [ -z "$GITDIR" ]; then
  echo "pre-push: could not resolve the git dir — body lint SKIPPED." >&2
  exit 0
fi
BODY="${PR_BODY_FILE:-$GITDIR/PR_BODY.md}"
LINT="$ROOT/marketplace/scripts/pr_body_lint.py"

if [ ! -e "$BODY" ]; then
  echo "pre-push: no PR body at $BODY — body lint SKIPPED (nothing to check)."
  echo "pre-push: the body IS the changelog; write the whole thing for the head you are about to"
  echo "pre-push: publish and push again. To lint a body that lives elsewhere: PR_BODY_FILE=<path>."
  exit 0
fi

# The umbrella's OWN reconciliation, and it runs whether or not the org's linter is
# here: the diff it reconciles against is this tree's, and it needs nothing from the
# marketplace submodule. Its skips are visible and never fail-closed, like the linter's.
RECONCILE="$ROOT/scripts/check-pr-body-diff.mjs"
if [ ! -f "$RECONCILE" ]; then
  echo "pre-push: $RECONCILE is absent — body/diff reconciliation SKIPPED." >&2
elif ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found — body/diff reconciliation SKIPPED." >&2
else
  echo "pre-push: reconciling the PR body against the diff ..."
  if node "$RECONCILE" --body "$BODY" --repo "$ROOT"; then
    echo "pre-push: OK (the body describes the diff it ships with)"
  else
    echo "pre-push: BLOCKED — the PR body does not describe the diff it is published with." >&2
    echo "pre-push: the body IS the changelog and the validator reads it live; fix EVERY finding" >&2
    echo "pre-push: and push again. Nothing about the diff's quality is judged here." >&2
    exit 1
  fi
fi

# ── the LIVE body: the copy the validator actually reads ───────────────────────────
# The body is validated as a FILE; the validator reads the PR's LIVE copy. This
# function is the reconciliation between the two, and it is the control whose absence
# let opencharly/opencharly#742 (2026-10-27) publish a body the reviewer never saw.
# It returns 0 when the two agree or when the comparison cannot be made (a VISIBLE
# skip, never a silent one), and 1 when they DISAGREE — which blocks the push.
#
# git hands a pre-push hook the refspec as arguments: $1 is the remote NAME, $3 the
# local ref. The branch is taken from $3 when it is a branch, and otherwise from
# HEAD — so the hook also works when it is run by hand, with no arguments at all.
live_body_check() {
  if ! command -v gh >/dev/null 2>&1; then
    echo "pre-push: gh is not installed — the LIVE-body check SKIPPED (the PR's body is not compared with $BODY)."
    return 0
  fi

  local remote_name="${1:-origin}" local_ref="${3:-}" branch=""
  case "$local_ref" in
    refs/heads/*) branch="${local_ref#refs/heads/}" ;;
  esac
  if [ -z "$branch" ]; then
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    [ "$branch" = "HEAD" ] && branch=""
  fi
  if [ -z "$branch" ]; then
    echo "pre-push: no branch to resolve a PR from (a detached HEAD, or a tag push) — the LIVE-body check SKIPPED."
    return 0
  fi

  local url path slug
  url="$(git config --get "remote.$remote_name.url" 2>/dev/null || true)"
  case "$url" in
    *github.com*) ;;
    *)
      echo "pre-push: remote '$remote_name' is not a GitHub remote — the LIVE-body check SKIPPED."
      return 0
      ;;
  esac
  path="${url#*github.com}"
  path="${path#:}"
  path="${path#/}"
  path="${path%.git}"
  slug="${path%%/*}/${path##*/}"

  local err="$GITDIR/pre-push-gh.err" pr="" ghrc=0 live="" lrc=0 local_body=""
  if ! : > "$err" 2>/dev/null; then err="/dev/null"; fi

  pr="$(gh pr list --repo "$slug" --head "$branch" --state open --json number --jq '.[0].number // empty' 2>"$err")" || ghrc=$?
  if [ "$ghrc" -ne 0 ]; then
    echo "pre-push: gh could not list the open PRs of $slug (gh exit $ghrc) — the LIVE-body check SKIPPED:" >&2
    sed -n '1p' "$err" >&2 2>/dev/null || true
    rm -f "$err" 2>/dev/null || true
    return 0
  fi
  if [ -z "$pr" ]; then
    echo "pre-push: no open PR for $slug head '$branch' — the LIVE-body check SKIPPED (the first push OPENS the PR; its body is set at creation)."
    rm -f "$err" 2>/dev/null || true
    return 0
  fi

  live="$(gh pr view "$pr" --repo "$slug" --json body --jq '.body' 2>"$err")" || lrc=$?
  rm -f "$err" 2>/dev/null || true
  if [ "$lrc" -ne 0 ]; then
    echo "pre-push: gh could not read the body of $slug#$pr (gh exit $lrc) — the LIVE-body check SKIPPED." >&2
    return 0
  fi

  # Command substitution strips the trailing newlines from BOTH sides, so the comparison
  # is about the body's TEXT and not about how the platform happens to terminate it.
  local_body="$(cat "$BODY" 2>/dev/null || true)"
  if [ "$local_body" = "$live" ]; then
    echo "pre-push: the LIVE body on $slug#$pr MATCHES $BODY — the body the validator reads is the one this push validated."
    return 0
  fi

  echo "pre-push: BLOCKED — the LIVE body on $slug#$pr does NOT match $BODY." >&2
  echo "pre-push: the validator reads the body LIVE, so the body the reviewer reads is the PR's — not this file." >&2
  echo "pre-push: publish the body, then push again:" >&2
  echo "pre-push:   gh pr edit $pr --repo $slug --body-file $BODY" >&2
  echo "pre-push: (this file is $(printf '%s' "$local_body" | wc -c) bytes; the PR holds $(printf '%s' "$live" | wc -c))" >&2
  return 1
}

if ! live_body_check; then
  exit 1
fi

if [ ! -f "$LINT" ]; then
  echo "pre-push: $LINT is absent (the marketplace submodule is not materialized here) — body lint SKIPPED."
  echo "pre-push: materialize it with: bash scripts/init-submodules.sh  (the working set includes the marketplace)"
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-push: python3 not found — body lint SKIPPED."
  exit 0
fi

# PRE-FLIGHT the linter, because a tool that cannot run is a VISIBLE SKIP, not a red.
# `pr_body_lint.py` imports a sibling module (`squash_body.py`), so a partial
# materialization — or any other breakage — makes it die with a Python traceback AND
# exit 1, which is INDISTINGUISHABLE from "findings" by exit code alone. Running
# `--help` exercises that import, so a non-zero here means the TOOL is broken and a
# non-zero from the real invocation below means the BODY has findings. Without this,
# one broken submodule blocks every legitimate push in the clone.
if ! python3 "$LINT" --help >/dev/null 2>&1; then
  echo "pre-push: the body linter cannot run here (it needs its sibling module from the marketplace submodule) — body lint SKIPPED." >&2
  echo "pre-push: materialize it with: bash scripts/init-submodules.sh  (the working set includes the marketplace)" >&2
  exit 0
fi

echo "pre-push: linting the PR body at $BODY ..."
if python3 "$LINT" "$BODY" --repo "$ROOT"; then
  echo "pre-push: OK"
  exit 0
fi

echo "pre-push: BLOCKED — the PR body above has findings." >&2
echo "pre-push: the body is the changelog and the validator reads it live; fix EVERY finding" >&2
echo "pre-push: and push again. Nothing about the diff is judged here." >&2
exit 1

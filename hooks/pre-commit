#!/usr/bin/env bash
# pre-commit — the umbrella's real gate.
#
# Activated per clone with `charly task hooks` (git config core.hooksPath hooks).
# This is repo configuration, not the `git -c core.hooksPath=… commit` bypass that
# .claude/hooks/gitcmd.py blocks (AGENTS.md R6).
#
# The gate is TWO parts:
#
#   1. the change-class legs — `hooks/pre-commit-gate.sh`, called ONCE. They are the
#      umbrella's own builders' self-tests (cheap: 3.4 s measured 2026-10-24, and they
#      need no binary, no project and no submodule) and the pin check (29 s measured
#      2026-10-24 over the umbrella's whole pin set, so it is decided by CHANGE CLASS:
#      it runs only when the staged diff changes one of the pin contract's
#      commit-carried inputs — a gitlink, the manifest that declares the pin
#      contract (charly.yml), or the declared path set (.gitmodules) — because those
#      are the only things it can violate; the checkout drift it also sees is caused
#      by no commit and stays with `charly task verify`
#      (opencharly/opencharly#661)). The legs live in their own file so that their
#      decision can be fired in isolation (`node scripts/check-pre-commit-gate.mjs`)
#      and so that the charly-backed pair has ONE owner — it used to run TWICE per
#      commit (opencharly/opencharly#645).
#   2. the pure-node gates below — each one a claim about a file in this repo, and
#      each one cheap enough to run on every commit.
#
# The node gates, in order:
#   1. opencode gate     — the TypeScript gate plugin contract
#   2. pr-watch gate     — the PR-watch plugin's pure logic + SDK delivery primitives
#   3. pi gate           — the pi gate extension fails CLOSED, uses the rule-2 worktree
#                          path, and wires both gate scripts (`node scripts/check-pi-gates.mjs`)
#   4. pi watch binding  — the pi wake binding delegates to the neutral watchers, wakes,
#                          re-arms, and ships inert (`node scripts/check-pi-watch.mjs`); plus
#                          the bed watcher's own `--self-test`
#   5. pi pr-status      — the PR-status tool normalises the state, finds the run by head
#                          SHA, reads jobs via REST, and classifies INCONCLUSIVE
#   6. pi question       — the `question` tool is dependency-free, headless-safe, serialized,
#                          and wired into `.pi/settings.json`
#   7. task contexts     — every step of every task in charly.yml declares a context the plan
#                          runner activates, so no step is a no-op in every mode
#                          (`node scripts/check-task-contexts.mjs`; opencharly/opencharly#413)
#   8. command text      — no `command:` step's text carries a braced reference: the plan
#                          runner CLAIMS one, and an unresolvable one SKIPS the step instead of
#                          failing it, so the gate reads green over a check that never ran
#                          (`node scripts/check-task-command-vars.mjs`)
#   9. pr-body gate      — the committed PRE-PUSH body gate (`hooks/pre-push`) is executable,
#                          defaults its body path to the git dir, skips visibly rather than
#                          fail-closed, and actually BLOCKS a defective body — asserted by
#                          FIRING it (`node scripts/check-pr-body-gate.mjs`;
#                          opencharly/marketplace#404)
#  10. commit gate       — the change-class legs above are decided by the index the commit
#                          carries, each leg runs EXACTLY ONCE, the no-binary path fails
#                          LOUD when the pin check is the leg that cannot run, and the skip
#                          is visible — asserted by FIRING the gate
#                          (`node scripts/check-pre-commit-gate.mjs`;
#                          opencharly/opencharly#602, #645, #498)
#  11. validator rule map — the validator's check ids equal the AGENTS.md "What the validator
#                          checks" table (`node scripts/check-validator-rule-map.mjs --no-live`;
#                          the committed-vs-live rulebook leg reads remote state, so it runs in
#                          `charly task verify`; opencharly/opencharly#446)
#  12. README measurements — the umbrella's MEASURED figures agree with each other: the
#                          clone-shape table, the prose that quotes it, and the date every
#                          dated figure carries (`node scripts/check-readme-measurements.mjs`).
#                          The SHAPE half rides with it: a count of a collection that GROWS
#                          (the submodules, the pins, the paths, the remotes) is a claim
#                          about a moving target, so it must be derived from the collection
#                          or carry the day it was measured.
#                          The SAMPLES half — a reading against its band — is NOT here: it
#                          needs the run's own log, so it is the MANUAL `--samples <log>`
#                          step after a measurement (the README says which), because a
#                          reading nobody measured is a reading no gate can see.
#  13. cited plugin-task version — every plugin-task version this repo's OWN prose cites
#                          equals the version the PINNED charly compiles; the version is
#                          DERIVED from the pin, so a charly pin bump turns the gate RED
#                          at the moment the citations beside it must be re-read
#                          (`node scripts/check-cited-plugin-task-version.mjs`;
#                          opencharly/opencharly#689)
#
# Deliberately NOT here (see `charly task verify`): the per-submodule
# `git ls-remote` default-branch audit — it reads remote state no commit can change
# — and the whole-tree cleanliness assertions, which are about the checkout rather
# than the diff.
set -euo pipefail

# Resolve the root FIRST: git exports GIT_DIR/GIT_INDEX_FILE to hooks so that git
# commands work regardless of cwd, but those vars LEAK into the subprocesses a hook
# runs and corrupt nested `git -C <submodule>` operations (they name THIS repo's git
# dir, not the submodule's). The former scripts scrubbed them internally at each git
# call; the charly task surface runs git through subprocesses, so scrub them here,
# once, at the hook boundary — after `rev-parse`, which needs them.
ROOT="$(git rev-parse --show-toplevel)"
# The index THIS commit carries. Git sets GIT_INDEX_FILE to a TEMPORARY index for a
# path-limited commit (`git commit <path>`), and that temporary index — not the
# repository's own — is the set of paths the commit carries. It is captured here,
# BEFORE the scrub, and handed to the gate, which reads the staged diff from it: a
# gate that decided on the repository's own index would judge a superset of the
# commit.
COMMIT_INDEX="${GIT_INDEX_FILE:-}"
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
cd "$ROOT"

# The change-class legs — ONCE, in their own file, so the decision can be fired in
# isolation and the charly-backed pair cannot be duplicated back into this hook.
bash "$ROOT/hooks/pre-commit-gate.sh" "$COMMIT_INDEX"

# ASCII `...`, never U+2026: this banner opens the transcript a PR pastes as its gate
# evidence. The codepoint is named here, never embedded, so a grep for it over this file
# stays meaningful, and the banner a gate prints is ASCII for the same reason. The org's
# body linter (marketplace/scripts/pr_body_lint.py) refuses the AUTHOR's elision of the
# evidence - an elided command line, an elided `head` command's output, a dropped line -
# and ALLOWS a program's own token (opencharly/marketplace#537), so a gate's own progress
# line is no longer a body finding: a pasted transcript is the product's, not the body's.
echo "pre-commit: running the umbrella gate..."

node "$ROOT/scripts/check-opencode-plugin.mjs"
node "$ROOT/scripts/check-pr-watch.mjs"
node "$ROOT/scripts/check-pi-gates.mjs"
node "$ROOT/scripts/check-pi-watch.mjs"
node "$ROOT/scripts/check-pi-pr-status.mjs"
node "$ROOT/scripts/check-pi-question.mjs"
node "$ROOT/scripts/check-task-contexts.mjs"
node "$ROOT/scripts/check-task-command-vars.mjs"
node "$ROOT/scripts/check-pr-body-gate.mjs"
node "$ROOT/scripts/check-pre-commit-gate.mjs"
node "$ROOT/scripts/check-validator-rule-map.mjs" --no-live
node "$ROOT/scripts/check-readme-measurements.mjs"
node "$ROOT/scripts/check-cited-plugin-task-version.mjs"
bash "$ROOT/scripts/check-bed-watch.sh" --self-test

echo "pre-commit: OK"

#!/usr/bin/env bash
# pre-commit — the umbrella's real gate.
#
# Activated per clone with `charly task hooks` (git config core.hooksPath hooks).
# This is repo configuration, not the `git -c core.hooksPath=… commit` bypass that
# .claude/hooks/gitcmd.py blocks (AGENTS.md R6).
#
# Runs ONLY the assertions a commit can actually violate, and only cheap ones — a
# pre-commit hook that takes minutes gets bypassed, which is worse than no hook:
#
#   1. policy B          — distro-* gitlinks must equal charly's box/* gitlinks
#                          (`charly task policy-b` → verb:git-submodules verify)
#   2. harness parity    — the 5 files byte-identical to charly's by design
#                          (`charly task harness` → verb:file-parity)
#   3. self-tests        — the committed CI body/pin-evidence builders
#                          (`charly task self-test`)
#   4. opencode gate     — the TypeScript gate plugin contract
#
# Deliberately NOT here (see `charly task verify`): the per-submodule
# `git ls-remote` default-branch audit — it reads remote state no commit can change
# — and the whole-tree cleanliness assertions, which are about the checkout rather
# than the diff.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# The charly binary comes from the `charly/` submodule (build it once per clone with
# ./charly/scripts/bootstrap-charly.sh). Resolve it from the umbrella root.
CHARLY="$ROOT/charly/bin/charly"
if [ ! -x "$CHARLY" ]; then
  echo "pre-commit: charly binary missing — run ./charly/scripts/bootstrap-charly.sh once" >&2
  exit 1
fi

echo "pre-commit: running the umbrella gate…"

"$CHARLY" task policy-b
"$CHARLY" task harness
"$CHARLY" task self-test
node "$ROOT/scripts/check-opencode-plugin.mjs"

echo "pre-commit: OK"

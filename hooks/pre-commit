#!/usr/bin/env bash
# pre-commit — the umbrella's real gate.
#
# Activated per clone with `charly task hooks` (git config core.hooksPath hooks).
# This is repo configuration, not the `git -c core.hooksPath=… commit` bypass that
# .claude/hooks/gitcmd.py blocks (AGENTS.md R6).
#
# Runs ONLY the assertions a commit can actually violate, and only cheap ones — a
# pre-commit hook that takes minutes gets bypassed, which is worse than no hook:
#
#   1. policy B          — distro-* gitlinks must equal charly's box/* gitlinks
#                          (`charly task policy-b` → verb:git-submodules verify)
#   2. self-tests        — the committed CI body/pin-evidence builders AND the
#                          dispatcher splice logic (`charly task self-test`, each
#                          script's own --self-test)
#   3. opencode gate     — the TypeScript gate plugin contract
#   4. pr-watch gate     — the PR-watch plugin's pure logic + SDK delivery primitives
#   5. pi gate           — the pi gate extension fails CLOSED, uses the rule-2 worktree
#                          path, and wires both gate scripts (`node scripts/check-pi-gates.mjs`)
#   6. pi watch binding  — the pi wake binding delegates to the neutral watchers, wakes,
#                          re-arms, and ships inert (`node scripts/check-pi-watch.mjs`); plus
#                          the bed watcher's own `--self-test`
#   7. pi pr-status      — the PR-status tool normalises the state, finds the run by head
#                          SHA, reads jobs via REST, and classifies INCONCLUSIVE
#   8. pi question        — the `question` tool is dependency-free, headless-safe, serialized,
#                          and wired into `.pi/settings.json`
#   9. task contexts      — every step of every task in charly.yml declares a context the plan
#                          runner activates, so no step is a no-op in every mode
#                          (`node scripts/check-task-contexts.mjs`; opencharly/opencharly#413)
#
# Deliberately NOT here (see `charly task verify`): the per-submodule
# `git ls-remote` default-branch audit — it reads remote state no commit can change
# — and the whole-tree cleanliness assertions, which are about the checkout rather
# than the diff.
set -euo pipefail

# Resolve the root FIRST: git exports GIT_DIR/GIT_INDEX_FILE to hooks so that git
# commands work regardless of cwd, but those vars LEAK into the subprocesses a hook
# runs and corrupt nested `git -C <submodule>` operations (they name THIS repo's git
# dir, not the submodule's). The former scripts scrubbed them internally at each git
# call; the charly task surface runs git through subprocesses, so scrub them here,
# once, at the hook boundary — after `rev-parse`, which needs them.
ROOT="$(git rev-parse --show-toplevel)"
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
cd "$ROOT"

# The charly-backed assertions (`task policy-b`, `task self-test`) need the binary from
# the `charly/` submodule. Resolution, in order:
#
#   1. THIS tree's build — the right binary for the source under test (R9: binary equals
#      source).
#   2. The MAIN clone's build. `charly task hooks` says "once per clone", and a LINKED
#      WORKTREE IS NOT A CLONE: `git rev-parse --show-toplevel` returns the WORKTREE path,
#      so a fresh worktree — which AGENTS.md Part II rule 2 mandates for every session —
#      has no binary at all and every commit in it died here, docs-only ones included.
#      (RCA 2026-10-08; the main clone is reached through the common git dir.)
#
# If NEITHER exists, the charly-backed assertions run anyway when the staged diff can
# actually violate one — a gitlink/submodule change (`task policy-b`) or a change under
# `charly/` (`task self-test`) — and are otherwise SKIPPED with a loud NOTICE naming
# exactly what was skipped and how to enable it. The skip is decided by CHANGE CLASS,
# never by a flag: there is still no bypass (R6), and a diff charly cannot judge is not
# silently trusted.
candidates=("$ROOT/charly/bin/charly")
common="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [ -n "$common" ]; then
  main_clone="$(cd "$common/.." 2>/dev/null && pwd || true)"
  if [ -n "$main_clone" ] && [ "$main_clone" != "$ROOT" ]; then
    candidates+=("$main_clone/charly/bin/charly")
  fi
fi
CHARLY=""
for candidate in "${candidates[@]}"; do
  if [ -x "$candidate" ]; then CHARLY="$candidate"; break; fi
done

needs_charly=0
# A gitlink change prints its mode in EITHER field: `:160000 160000 …` (changed),
# `:000000 160000 …` (a submodule ADDED — a pin bump, exactly what `policy-b` judges)
# and `:160000 000000 …` (removed). Testing only the first field would skip the charly
# assertions on the very commit that introduces a pin — so match either.
if git diff --cached --raw | cut -d' ' -f1,2 | grep -q '160000'; then needs_charly=1; fi
if git diff --cached --name-only | grep -q '^charly/'; then needs_charly=1; fi

if [ -z "$CHARLY" ]; then
  if [ "$needs_charly" -eq 1 ]; then
    echo "pre-commit: no charly binary, and this commit changes charly/ source or a gitlink," >&2
    echo "  so the assertions that judge exactly that cannot run." >&2
    echo "  looked for: ${candidates[*]}" >&2
    echo "  fix: ./charly/scripts/bootstrap-charly.sh    (in THIS tree: $ROOT)" >&2
    exit 1
  fi
  echo "pre-commit: NOTICE — no charly binary in this tree or its main clone, so the"
  echo "  charly-backed assertions are SKIPPED: charly task policy-b, charly task self-test."
  echo "  They are skipped because this diff touches neither charly/ nor any gitlink — the"
  echo "  only two things a commit can violate in them. Run"
  echo "  ./charly/scripts/bootstrap-charly.sh to run them anyway."
else
  if [ "$CHARLY" != "$ROOT/charly/bin/charly" ]; then
    echo "pre-commit: NOTICE — using the main clone's charly binary: $CHARLY"
    echo "  (this tree has none; R9 prefers a worktree-local build, so re-run"
    echo "   ./charly/scripts/bootstrap-charly.sh here if this tree's charly/ differs)"
  fi
  "$CHARLY" task policy-b
  "$CHARLY" task self-test
fi

# ASCII `...`, never U+2026: this banner opens the transcript a PR pastes as its gate
# evidence, and the org's body linter (marketplace/scripts/pr_body_lint.py) fails a fenced
# block containing U+2026 as "pasted output is verbatim, never ellipsized" - so the gate's
# own progress line made every pasted umbrella-gate transcript a body finding. The
# codepoint is named, never embedded, so a grep for it over this file stays meaningful.
echo "pre-commit: running the umbrella gate..."

"$CHARLY" task policy-b
"$CHARLY" task self-test
node "$ROOT/scripts/check-opencode-plugin.mjs"
node "$ROOT/scripts/check-pr-watch.mjs"
node "$ROOT/scripts/check-pi-gates.mjs"
node "$ROOT/scripts/check-pi-watch.mjs"
node "$ROOT/scripts/check-pi-pr-status.mjs"
node "$ROOT/scripts/check-pi-question.mjs"
node "$ROOT/scripts/check-task-contexts.mjs"
bash "$ROOT/scripts/check-bed-watch.sh" --self-test

echo "pre-commit: OK"
